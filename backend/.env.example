# PostgreSQL connection string (provided by the platform or your local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/gradelens

# JWT signing secret (min 32 characters). Falls back to SESSION_SECRET if unset/short.
JWT_SECRET=

# Session secret provided by the platform (kept here for completeness)
SESSION_SECRET=

# CORS origin for the frontend. Use the full URL (e.g. http://localhost:3000)
# or set to '*' to allow any origin (useful for preview / unknown origins).
FRONTEND_URL=http://localhost:3000
# Set to true to allow any CORS origin (useful when the preview URL is dynamic).
PREVIEW_MODE=false

# Groq LLM credentials (used in later phases)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Optional OCR fallback for scanned PDFs (used in later phases)
OCR_ENABLED=false
