# Root environment example for the GradeLens preview.
# Copy to .env.local (Next.js frontend) and backend/.env (FastAPI backend).

# --- Backend (also required in backend/.env) ---
DATABASE_URL=postgresql://user:password@localhost:5432/gradelens
# JWT signing secret (min 32 characters). Falls back to SESSION_SECRET if unset/short.
JWT_SECRET=
SESSION_SECRET=
# Use '*' for preview / unknown origins, or the exact frontend URL.
FRONTEND_URL=http://localhost:3000
# Set to true to allow any CORS origin (useful when the preview URL is dynamic).
PREVIEW_MODE=false
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
OCR_ENABLED=false

# --- Frontend (Next.js at repo root) ---
# API calls use the shared-origin /api proxy; no frontend secret is required.
# NEXT_PUBLIC_API_URL is intentionally omitted; use the proxy in next.config.js.
